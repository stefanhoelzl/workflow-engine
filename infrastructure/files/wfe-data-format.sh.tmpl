#!/usr/bin/env bash
# Format the per-env Block Storage data volumes on first use. Run as root by
# wfe-data-format.service (a oneshot ordered Before the srv-wfe-*.mount units),
# so it needs no sudoers verbs — systemd executes it as root.
#
# Idempotent and fail-SAFE:
#   - mkfs runs ONLY when `blkid -p` finds no signature on the resolved device,
#     so an already-formatted volume (e.g. reattached after a VPS replacement)
#     and the mounted root are never reformatted.
#   - if a device can't be resolved, it logs and skips — the by-label .mount
#     then finds nothing and the container's mountpoint guard stays red. Loud,
#     never destructive.
#
# Device resolution (per Scaleway's documented device contract): an attached
# Block Storage (sbs) volume appears as a SCSI disk (/dev/sd*) with a stable
# udev symlink /dev/disk/by-id/scsi-0SCW_sbs_volume-<uuid> and a serial of
# "volume-<uuid>". The local/root volume is virtio (/dev/vda) with no serial,
# so the SBS data volumes are unambiguous. We resolve by the by-id symlink
# first (canonical), then fall back to the SCSI serial.
set -uo pipefail

# Rendered by tofu: one "<volume-uuid>:<fs-label>" per data volume.
SPECS=(
%{ for s in specs ~}
  "${s}"
%{ endfor ~}
)

resolve_dev() {
  local uuid="$1" l d s
  # Canonical: the documented Scaleway SBS by-id symlink. The globs are
  # robustness fallbacks in case the udev prefix shifts across provider
  # versions (the "volume-<uuid>" infix is the stable part).
  for l in \
    "/dev/disk/by-id/scsi-0SCW_sbs_volume-$uuid" \
    /dev/disk/by-id/*"volume-$uuid" \
    /dev/disk/by-id/*"$uuid"*; do
    [ -e "$l" ] && { readlink -f "$l"; return 0; }
  done
  # Fallback: match the block device serial directly (SBS serial = volume-<uuid>).
  for d in /sys/block/sd* /sys/block/vd*; do
    [ -e "$d/serial" ] || continue
    s="$(cat "$d/serial" 2>/dev/null || true)"
    case "$s" in "volume-$uuid" | "$uuid") echo "/dev/$(basename "$d")"; return 0 ;; esac
  done
  return 1
}

rc=0
for spec in "$${SPECS[@]}"; do
  uuid="$${spec%%:*}"
  label="$${spec#*:}"
  dev="$(resolve_dev "$uuid")" || {
    echo "wfe-data-format: no block device resolved for volume $uuid ($label); skipping"
    continue
  }
  if blkid -p "$dev" >/dev/null 2>&1; then
    echo "wfe-data-format: $dev already has a filesystem/partition signature; skipping mkfs ($label)"
    continue
  fi
  echo "wfe-data-format: formatting $dev as ext4 label=$label"
  if ! mkfs.ext4 -q -L "$label" "$dev"; then
    echo "wfe-data-format: mkfs failed for $dev ($label)" >&2
    rc=1
  fi
done

# Ensure the /dev/disk/by-label/* symlinks for any freshly-created labels are
# registered before this oneshot completes, so the srv-wfe-*.mount units
# (ordered After this service) find their What=/dev/disk/by-label/... target.
command -v udevadm >/dev/null 2>&1 && udevadm settle --timeout=10 || true

exit "$rc"
