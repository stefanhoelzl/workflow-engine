[Unit]
Description=workflow-engine ${env_name}
Wants=network-online.target
After=network-online.target

[Container]
# This Quadlet runs as a user-mode systemd unit under the per-tenant
# `wfe-${env_name}` host user (linger-enabled). Podman runs rootless under
# that user; in-container UID is 65532 (Dockerfile USER), which the user
# namespace maps into the tenant's subuid range. Cross-tenant filesystem
# isolation is enforced because each tenant's subuid space is disjoint.
Image=${image_ref}
# Tag-based auto-update — podman-auto-update.timer polls the registry and
# restarts this unit when the manifest digest at the configured tag changes.
Label=io.containers.autoupdate=registry
PublishPort=127.0.0.1:${host_port}:8080
# Hairpin self-reach: rootless pasta gives src=public-IP for outbound, so a
# direct connect to our own public IP is rejected by the kernel. Map the
# public hostname to the host-gateway address (169.254.1.2 under pasta);
# Caddy serves the matching TLS cert via SNI, so https:// just works.
# Required by /readyz domain/webhooks probes and by workflows that fetch
# their own httpTriggers / OAuth callbacks.
AddHost=${domain}:host-gateway
# `:U` makes Podman chown the source dir to match the container's UID
# (65532 per the Dockerfile) at start time. Without it, the container
# process can't write to a host dir owned by `deploy`.
Volume=${data_dir}:/data:Z,U
# Memory budget. Must be enforced on the container *payload* cgroup so
# software inside that auto-sizes from detected memory (DuckDB, V8) reads
# the real limit via /sys/fs/cgroup/memory.max. Two non-obvious constraints:
# - Quadlet's `Memory=` key is unsupported on podman 5.4.2 (`quadlet
#   -dryrun`: "unsupported key 'Memory'"); `PodmanArgs=--memory=` is the
#   working spelling.
# - Do NOT reintroduce `[Service] MemoryMax=` — that lands on the parent
#   service cgroup, which is invisible from inside the container, so
#   DuckDB sized its buffer pool to 80% of *host* RAM and got OOM-killed
#   (each kill rotates the in-memory session-sealing key, breaking logins).
PodmanArgs=--memory=${memory_max}
# Non-secret config: passed as systemd `Environment=` so each value goes
# through Quadlet → podman as a separate `--env KEY=VALUE` flag. Avoids
# `--env-file` parser quirks (Podman's env-file reader mis-splits values
# with commas — e.g. AUTH_ALLOW ends up as one giant entry).
Environment=PERSISTENCE_PATH=/data
Environment=PORT=8080
Environment=AUTH_PROVIDER=github
Environment=BASE_URL=${base_url}
Environment=AUTH_ALLOW=${auth_allow}
# EventStore retention window in days (0 disables; prune interval is derived as
# days/100). See docs/infrastructure.md.
Environment=EVENT_STORE_RETENTION_DAYS=${retention_days}
# Secrets only — env file is two lines now.
EnvironmentFile=/etc/wfe/${env_name}.env

[Service]
# Durability guard: refuse to start unless the env's Block Storage volume is
# actually mounted at ${data_dir}. The .mount unit uses `nofail` so a missing
# volume never wedges boot — without this check the container would start, :U
# would chown the bare mount point on the root fs, and the app would silently
# write events to non-durable root storage. This converts that silent failure
# into a loud one (container down + /readyz red); Restart=always retries, so
# the unit self-heals once the volume mounts.
ExecStartPre=/usr/bin/mountpoint -q ${data_dir}
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target default.target
