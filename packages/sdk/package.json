{
	"name": "@workflow-engine/sdk",
	"description": "SDK for authoring workflow-engine workflows: DSL, triggers, event schemas, Zod re-exports.",
	"version": "0.0.0-dev",
	"type": "module",
	"sideEffects": false,
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/stefanhoelzl/workflow-engine.git",
		"directory": "packages/sdk"
	},
	"exports": {
		".": "./src/index.ts",
		"./cli": "./src/cli/index.ts"
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./cli": {
				"types": "./dist/cli/index.d.ts",
				"default": "./dist/cli/index.js"
			}
		}
	},
	"bin": {
		"wfe": "./dist/cli/cli.js"
	},
	"scripts": {
		"build": "tsc --build",
		"prepare": "pnpm build"
	},
	"files": [
		"dist",
		"!dist/**/*.test.js",
		"!dist/**/*.test.d.ts",
		"example.ts",
		"README.md"
	],
	"dependencies": {
		"@workflow-engine/core": "workspace:*",
		"citty": "^0.2.2",
		"magic-string": "^0.30.21",
		"tar-stream": "^3.1.8",
		"ts-cron-validator": "^1.1.5",
		"tsx": "^4.21.0",
		"vite": "^8.0.8",
		"zod": "^4.0.0"
	},
	"peerDependencies": {
		"typescript": ">=5.0.0 <7"
	},
	"devDependencies": {
		"@types/tar-stream": "^3.1.4",
		"typescript": "^6.0.2"
	}
}
